# Copia este archivo como `.env` (raíz, usado por docker compose) o como `api/.env` y `web/.env.local`.
# Ninguna variable es secreta; aun así, no subas tus archivos .env al repositorio.

# ---------- API (FastAPI) ----------
# Orígenes permitidos por CORS (separados por comas). El navegador habla con Next, que hace de proxy;
# solo hace falta si alguien llama a la API directamente desde un navegador.
ALLOWED_ORIGINS=http://localhost:3000
# Tamaño máximo de imagen en MB (debe coincidir con NEXT_PUBLIC_MAX_UPLOAD_MB).
MAX_UPLOAD_MB=8
# Límite de píxeles (anti decompression bomb), lado mínimo y proporción máxima.
MAX_IMAGE_PIXELS=40000000
MIN_IMAGE_SIDE=64
MAX_ASPECT_RATIO=5
# Límite de solicitudes por IP (sintaxis de slowapi/limits).
RATE_LIMIT=20/minute
# true SOLO si la API únicamente es accesible a través del proxy de Next (usa X-Forwarded-For para el rate limit).
TRUST_FORWARDED_FOR=false
# Tiempo máximo de inferencia (s).
INFERENCE_TIMEOUT_S=30
# Hilos de TensorFlow (0 = automático).
TF_INTRA_OP_THREADS=0
TF_INTER_OP_THREADS=0
# Carpeta de modelos y verificación de integridad.
# MODELS_DIR=./models
VERIFY_SHA256=true

# Umbrales de calidad. Vacío = usar los calibrados con Validation (api/models/manifest.json).
BEAN_T_MIN=
BEAN_T_WARN=
BEAN_T_MARGIN=
CASSAVA_T_MIN=
CASSAVA_T_WARN=
CASSAVA_T_MARGIN=
# Entropía normalizada máxima y fracción mínima de píxeles "vegetales" (heurísticas no calibradas).
T_ENTROPY=0.85
MIN_LEAF_RATIO=0.12

# ---------- Web (Next.js) ----------
# URL interna de la API vista desde el servidor de Next (no se expone al navegador).
API_URL=http://127.0.0.1:8000
# Límite mostrado y validado en el navegador (MB).
NEXT_PUBLIC_MAX_UPLOAD_MB=8
